{
  "name": "kanji-everyday-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "npm run lint && npm run typecheck && npm run test",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:s10:assert-db": "node -e \"if (!(process.env.S10_TEST_DATABASE_URL || '').trim()) { console.error('S10_TEST_DATABASE_URL is required for S-10 database tests'); process.exit(1) }\"",
    "test:s10:unit": "vitest run ../specs/stories/S-10-ai-card-import-foundation/tests/ai-card-import-foundation.test.ts",
    "test:s10:integration": "npm run test:s10:assert-db && vitest run ../specs/stories/S-10-ai-card-import-foundation/tests/ai-card-import-foundation.int.test.ts",
    "test:s10:e2e": "npm run test:s10:assert-db && vitest run ../specs/stories/S-10-ai-card-import-foundation/tests/ai-card-import-foundation.e2e.test.ts",
    "test:s10:fresh": "vite-node -c vitest.config.ts ../specs/stories/S-10-ai-card-import-foundation/tests/helpers/s10-db-jobs.ts fresh",
    "test:s10:upgrade": "vite-node -c vitest.config.ts ../specs/stories/S-10-ai-card-import-foundation/tests/helpers/s10-db-jobs.ts upgrade",
    "test:s10:failure": "vite-node -c vitest.config.ts ../specs/stories/S-10-ai-card-import-foundation/tests/helpers/s10-db-jobs.ts failure",
    "test:s10:inventory": "vitest run ../specs/stories/S-10-ai-card-import-foundation/tests/ai-card-import-foundation.test.ts ../specs/stories/S-10-ai-card-import-foundation/tests/ai-card-import-foundation.int.test.ts ../specs/stories/S-10-ai-card-import-foundation/tests/ai-card-import-foundation.e2e.test.ts",
    "test:s11:unit": "vitest run ../specs/stories/S-11-ai-card-async-processing/tests/ai-card-async-processing.test.ts",
    "test:s11:integration": "vitest run ../specs/stories/S-11-ai-card-async-processing/tests/ai-card-async-processing.int.test.ts",
    "test:s11:e2e": "vitest run ../specs/stories/S-11-ai-card-async-processing/tests/ai-card-async-processing.e2e.test.ts",
    "test:s11:fresh": "vite-node -c vitest.config.ts ../specs/stories/S-11-ai-card-async-processing/tests/helpers/s11-db-jobs.ts fresh",
    "test:s11:upgrade": "vite-node -c vitest.config.ts ../specs/stories/S-11-ai-card-async-processing/tests/helpers/s11-db-jobs.ts upgrade",
    "test:s11:failure": "vite-node -c vitest.config.ts ../specs/stories/S-11-ai-card-async-processing/tests/helpers/s11-db-jobs.ts failure",
    "test:s11:resource": "vite-node -c vitest.config.ts ../specs/stories/S-11-ai-card-async-processing/tests/edge-resource-gate.ts",
    "test:s11:real-integration": "vite-node -c vitest.config.ts ../specs/stories/S-11-ai-card-async-processing/tests/s11-real-integration-gate.ts",
    "test:s11:local-real-integration": "vite-node -c vitest.config.ts ../specs/stories/S-11-ai-card-async-processing/tests/s11-local-real-integration-gate.ts",
    "test:s11:real-e2e": "vite-node -c vitest.config.ts ../specs/stories/S-11-ai-card-async-processing/tests/s11-real-e2e-gate.ts",
    "test:s11:deno": "vite-node -c vitest.config.ts ../specs/stories/S-11-ai-card-async-processing/tests/s11-deno-gate.ts",
    "test:s11:inventory": "vitest run ../specs/stories/S-11-ai-card-async-processing/tests/ai-card-async-processing.test.ts ../specs/stories/S-11-ai-card-async-processing/tests/ai-card-async-processing.int.test.ts ../specs/stories/S-11-ai-card-async-processing/tests/ai-card-async-processing.e2e.test.ts",
    "test:s12:unit": "vitest run ../specs/stories/S-12-ai-card-openai-generation-ui/tests/ai-card-openai-generation-ui.test.ts",
    "test:s12:integration": "vitest run ../specs/stories/S-12-ai-card-openai-generation-ui/tests/ai-card-openai-generation-ui.int.test.ts",
    "test:s12:e2e": "vitest run ../specs/stories/S-12-ai-card-openai-generation-ui/tests/ai-card-openai-generation-ui.e2e.test.ts",
    "test:s12:real-db": "vite-node -c vitest.config.ts ../specs/stories/S-12-ai-card-openai-generation-ui/tests/s12-local-real-db-gate.ts",
    "test:s12:inventory": "vitest run ../specs/stories/S-12-ai-card-openai-generation-ui/tests/ai-card-openai-generation-ui.test.ts ../specs/stories/S-12-ai-card-openai-generation-ui/tests/ai-card-openai-generation-ui.int.test.ts ../specs/stories/S-12-ai-card-openai-generation-ui/tests/ai-card-openai-generation-ui.e2e.test.ts"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "0.0.35",
    "@supabase/ssr": "^0.6.0",
    "@supabase/supabase-js": "^2.47.16",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}
